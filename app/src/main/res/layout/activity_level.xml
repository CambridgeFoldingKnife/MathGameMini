<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">
<!--    状态栏占位，由系统决定高度-->
    <View
        android:id="@+id/top_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"/>
<!--顶部栏-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart= "@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8">

<!--    关闭按钮-->
    <TextView
        android:id="@+id/tv_close"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_68"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="×️"
        android:textColor="@color/text_dark"
        android:textStyle="bold"
        android:textSize="@dimen/sp_32"/>

<!--  进度条-->
<TextView
    android:id="@+id/tv_progress"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:textColor="@color/text_dark"
    android:textSize="@dimen/sp_16"
    tools:text = "第 1/5 题"/>
<!--爱心-->
    <TextView
        android:id="@+id/tv_heart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/heart_red"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        tools:text="❤ 5"/>
<!--小旗子-->
        <TextView
            android:id="@+id/tv_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vector_ic_report"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>

   </LinearLayout>


<!--    分割线-->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

<!--    题目区域==================================================-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <!--    题目整体区域   -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--       左操作数：被加数-->
            <TextView
                android:id="@+id/tv_left_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_num"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:minWidth="@dimen/dp_60"
                android:textSize="@dimen/sp_64"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tv_plus"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="3" />

            <!--左侧操作符： 加号 + -->

            <TextView
                android:id="@+id/tv_plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:fontFamily="@font/font_num"
                android:text="+"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_64"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_left_num"
                app:layout_constraintEnd_toStartOf="@+id/tv_right_num"
                app:layout_constraintStart_toEndOf="@+id/tv_left_num"
                app:layout_constraintTop_toTopOf="@+id/tv_left_num"
                tools:text="+" />
            <!--      左侧操作数： 加数-->
            <TextView
                android:id="@+id/tv_right_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_64"
                android:minWidth="@dimen/dp_60"
                android:gravity="center_horizontal"
                android:fontFamily="@font/font_num"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_left_num"
                app:layout_constraintEnd_toStartOf="@+id/tv_equal"
                app:layout_constraintStart_toEndOf="@+id/tv_plus"
                app:layout_constraintTop_toTopOf="@+id/tv_left_num"
                tools:text="3" />
            <!--           等号    =-->
            <TextView
                android:id="@+id/tv_equal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:text="="
                android:textColor="@color/black"
                android:textSize="@dimen/sp_64"
                android:textStyle="bold"
                android:fontFamily="@font/font_num"
                app:layout_constraintBottom_toBottomOf="@+id/tv_left_num"
                app:layout_constraintEnd_toStartOf="@+id/tv_answer"
                app:layout_constraintStart_toEndOf="@+id/tv_right_num"
                app:layout_constraintTop_toTopOf="@+id/tv_left_num" />

            <TextView
                android:id="@+id/tv_answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_num"
                android:text="?"
                android:textColor="@color/answer_blue"
                android:textSize="@dimen/sp_64"
                app:layout_constraintStart_toEndOf="@+id/tv_equal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_left_num"
                app:layout_constraintBottom_toBottomOf="@+id/tv_left_num"
                tools:text="?" />

<!--            左边操作数苹果-->

<!--    vertical_bias=0 是为了让左右两组苹果都从顶部开始排
否则苹果少的那一边可能会被垂直居中，看起来比另一边低。-->
            <LinearLayout
                android:id="@+id/ll_apple_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintStart_toStartOf="@+id/tv_left_num"
                app:layout_constraintEnd_toEndOf="@+id/tv_left_num"
                app:layout_constraintTop_toBottomOf="@+id/tv_left_num"
                app:layout_constraintBottom_toBottomOf="parent"/>

<!--                右边苹果 ：绑在加数的下面-->
            <LinearLayout
                android:id="@+id/ll_apple_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintStart_toStartOf="@+id/tv_right_num"
                app:layout_constraintEnd_toEndOf="@+id/tv_right_num"
                app:layout_constraintTop_toBottomOf="@+id/tv_right_num"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


<!--键盘容器=====================================================-->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_8"
    android:paddingBottom="@dimen/dp_8">

    <!--    第1行 灯泡、0、删除-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_hint"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            android:background="@drawable/bg_key_button"
            android:scaleType="centerInside"
            android:padding="@dimen/dp_16"
            app:srcCompat="@drawable/vector_ic_tips" />

        <TextView
            android:id="@+id/btn_0"
            style="@style/KeyButton"
            android:text="0"
            android:background="@drawable/bg_key_button"/>

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_64"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_key_button"
                android:padding="@dimen/dp_16"
                android:scaleType="centerInside"
                app:srcCompat = "@drawable/vector_ic_delete"
                android:visibility="invisible"/>
    </LinearLayout>


<!--    第2行 123-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
             android:id="@+id/btn_1"
            style="@style/KeyButton"
            android:text="1"/>
        <TextView
            android:id="@+id/btn_2"
            style="@style/KeyButton"
            android:text="2"/>
        <TextView
            android:id="@+id/btn_3"
            style="@style/KeyButton"
            android:text="3"/>

    </LinearLayout>

    <!--    第3行 456 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_4"
            style="@style/KeyButton"
            android:text="4"/>
        <TextView
            android:id="@+id/btn_5"
            style="@style/KeyButton"
            android:text="5"/>
        <TextView
            android:id="@+id/btn_6"
            style="@style/KeyButton"
            android:text="6"/>
    </LinearLayout>

        <!--    第四行789-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_7"
                style="@style/KeyButton"
                android:text="7"/>
            <TextView
                android:id="@+id/btn_8"
                style="@style/KeyButton"
                android:text="8"/>
            <TextView
                android:id="@+id/btn_9"
                style="@style/KeyButton"
                android:text="9"/>
        </LinearLayout>

    <!--    第5行 跳过、检查-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="120dp"
            android:layout_height="@dimen/dp_60"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="@dimen/dp_8"
            android:background="@drawable/bg_key_button"
            android:gravity="center"
            android:minWidth="@dimen/dp_96"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:text="@string/key_skip"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/btn_check"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_60"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@color/level_green"
            android:gravity="center"
            android:text="@string/key_check"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

        </LinearLayout>

<!--    导航栏占位-->
<View
    android:id="@+id/bottom_space"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@color/white"/>


    </LinearLayout>


